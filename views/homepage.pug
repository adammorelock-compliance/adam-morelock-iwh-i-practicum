doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1= title
    p
      a(href="/update-cobj") Add to this table
    table
      thead
        tr
          each prop in properties
            th= prop.label
      tbody
        if records.length
          each record in records
            tr
              each prop in properties
                td= record.properties[prop.name]
        else
          tr
            td(colspan=properties.length) No records yet.
